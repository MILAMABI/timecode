{
  "name": "playhead",
  "productName": "Playhead",
  "version": "2.1.0",
  "description": "Playhead — трекер времени для креативщиков: видео, фото, дизайн, моушн, звук. Сам пишет время в рабочих программах и раскладывает по этапам и проектам.",
  "main": "src/main.js",
  "author": "MILAMABI",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/engine.test.js && node test/store.test.js && node test/focus.test.js && node test/professions.test.js && node test/projects.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac-arm": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac-intel": "electron-builder --mac dmg --x64 --publish never",
    "obfuscate": "node build/obfuscate.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "app.timecode.tracker",
    "productName": "Playhead",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helpers/resolve_helper.py",
        "to": "resolve_helper.py"
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "tray*.png"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "LSUIElement": false,
        "NSAppleEventsUsageDescription": "Playhead нужно видеть, какая программа открыта (Premiere, Lightroom, Figma и другие), чтобы считать рабочее время."
      }
    },
    "dmg": {
      "title": "Playhead",
      "artifactName": "Playhead-${version}-${arch}.dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "artifactName": "Playhead-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Playhead",
      "license": "LICENSE"
    },
    "compression": "maximum",
    "afterPack": "build/afterPack.js",
    "copyright": "© 2026 MILAMABI. Все права защищены."
  }
}
